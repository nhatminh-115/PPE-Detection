# 1. Git & CI/CD Meta-data (Not needed in production container)
.git/
.github/
.gitignore

# 2. Documentation & Local Tests
README.md
LICENSE
tests/
sanity_check.py

# 3. Environment Secrets (Must be injected at runtime, NOT baked into image)
.env

# 4. Python Cache
__pycache__/
*.pyc
.pytest_cache/

# 5. Ephemeral Directories & Heavy Data (Must use Docker Volumes instead)
datasets/
model_cache/
temp_uploads/
violation_crops/

# 6. Extraneous Scripts (Only keep what the API needs)
*.pt
*.pth
*.onnx

