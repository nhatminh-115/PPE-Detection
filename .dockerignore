# VCS / CI metadata
.git/
.github/
.gitignore

# Local environment / editors
.env
.env.*
!.env.example
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docs and local-only assets
README.md
LICENSE
docs/
tests/
extras/
huggingfacespace/
.agents/

# Python cache
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime-generated artifacts (mounted as volumes in docker-compose)
model_cache/
temp_uploads/
violation_crops/
runs/

# Large training data and scripts
datasets/
training/

# Keep only the RAG vector store in build context
data/*
!data/chroma_db/
!data/chroma_db/**

# Local helper scripts not required by API runtime
eval_report.py
benchmark_sr.py

# SQL migrations and local project meta not needed by runtime container
supabase/
.claude/
.agents/